# Neon PostgreSQL (projeto NOVO e isolado da 4S Contábil)
DATABASE_URL=postgres://user:password@ep-xxx.aws.neon.tech/db?sslmode=require
# Usuário admin inicial (usado só por db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# URL pública do sistema (usada nos e-mails)
APP_URL=https://fours-contabil.onrender.com
# E-mail transacional (Resend). Sem isso, o envio por e-mail fica desativado e o resto funciona.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
